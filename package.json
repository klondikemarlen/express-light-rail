{
  "name": "express-light-rail",
  "version": "0.11.0",
  "description": "Rails-inspired controller, policy, and service primitives for Express applications.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./contracts": {
      "import": {
        "types": "./dist/contracts/index.d.ts",
        "default": "./dist/contracts/index.js"
      },
      "require": {
        "types": "./dist/commonjs/contracts/index.d.ts",
        "default": "./dist/contracts/index.cjs"
      }
    },
    "./tooling/eslint": {
      "import": {
        "types": "./dist/tooling/eslint.d.ts",
        "default": "./dist/tooling/eslint.js"
      },
      "require": {
        "types": "./dist/commonjs/tooling/eslint.d.ts",
        "default": "./dist/tooling/eslint.cjs"
      }
    },
    "./tooling/prettier": {
      "import": {
        "types": "./dist/tooling/prettier.d.ts",
        "default": "./dist/tooling/prettier.js"
      },
      "require": {
        "types": "./dist/commonjs/tooling/prettier.d.ts",
        "default": "./dist/tooling/prettier.cjs"
      }
    },
    "./tooling/vitest": {
      "import": {
        "types": "./dist/tooling/vitest.d.ts",
        "default": "./dist/tooling/vitest.js"
      },
      "require": {
        "types": "./dist/commonjs/tooling/vitest.d.ts",
        "default": "./dist/tooling/vitest.cjs"
      }
    },
    "./jobs/bullmq": {
      "import": {
        "types": "./dist/jobs/bullmq/index.d.ts",
        "default": "./dist/jobs/bullmq/index.js"
      },
      "require": {
        "types": "./dist/commonjs/jobs/bullmq/index.d.ts",
        "default": "./dist/jobs/bullmq/index.cjs"
      }
    },
    "./channels/socket-io": {
      "import": {
        "types": "./dist/channels/socket-io/index.d.ts",
        "default": "./dist/channels/socket-io/index.js"
      },
      "require": {
        "types": "./dist/commonjs/channels/socket-io/index.d.ts",
        "default": "./dist/channels/socket-io/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "docs/**/*.md",
    "src/**/*.md"
  ],
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && vite build",
    "example": "tsc -p example-app/tsconfig.json && tsc-alias -p example-app/tsconfig.json && node .example-app/server.js",
    "test": "vitest",
    "prepublishOnly": "npm run check-types && npm run test -- --run && npm run build",
    "ts-node": "ts-node -r tsconfig-paths/register --logError",
    "lint": "eslint .",
    "check-types": "tsc -p tests/tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klondikemarlen/express-light-rail.git"
  },
  "keywords": [
    "express",
    "controller",
    "model",
    "service",
    "rails"
  ],
  "author": "Marlen Brunner",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@eslint/js": ">=9 <10",
    "@sequelize/core": "^7.0.0-alpha.43",
    "bullmq": ">=5.81.5 <6",
    "eslint": ">=9 <10",
    "eslint-config-prettier": ">=10 <11",
    "express": "^4.21.2",
    "prettier": ">=3 <4",
    "socket.io": ">=4.8.4 <5",
    "typescript": ">=5.7 <6",
    "typescript-eslint": ">=8.24 <9",
    "vite": ">=5 <6",
    "vite-tsconfig-paths": ">=5 <6",
    "vitest": ">=2.1 <3"
  },
  "peerDependenciesMeta": {
    "@eslint/js": {
      "optional": true
    },
    "bullmq": {
      "optional": true
    },
    "eslint": {
      "optional": true
    },
    "eslint-config-prettier": {
      "optional": true
    },
    "prettier": {
      "optional": true
    },
    "socket.io": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "typescript-eslint": {
      "optional": true
    },
    "vite": {
      "optional": true
    },
    "vite-tsconfig-paths": {
      "optional": true
    },
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "lodash": "^4.17.21",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@sequelize/core": "7.0.0-alpha.48",
    "@sequelize/sqlite3": "7.0.0-alpha.48",
    "@types/cors": "^2.8.19",
    "@types/eslint-config-prettier": "^6.11.3",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/qs": "^6.15.1",
    "@types/supertest": "^6.0.2",
    "bullmq": "^5.81.5",
    "cors": "^2.8.6",
    "eslint": "^9.20.1",
    "eslint-config-prettier": "^10.0.1",
    "express": "^4.21.2",
    "express-oauth2-jwt-bearer": "^1.11.0",
    "factory-shark": "2.0.0",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "qs": "^6.17.0",
    "socket.io": "^4.8.4",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.10",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vite": "^5.4.21",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^2.1.8"
  }
}
