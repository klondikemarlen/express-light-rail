{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Promise", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["**/*.ts", "**/*.mts", "**/*.cts"]
}
